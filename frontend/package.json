{
  "name": "homelab-wrapped-frontend",
  "private": true,
  "type": "module",
  "description": "The Homelab Wrapped sidebar panel, built to one file in custom_components/homelab_wrapped/frontend/.",
  "scripts": {
    "build": "tsc && esbuild src/homelab-wrapped-panel.ts --bundle --format=esm --target=es2022 --minify --legal-comments=eof --outfile=../custom_components/homelab_wrapped/frontend/homelab-wrapped-panel.js",
    "watch": "esbuild src/homelab-wrapped-panel.ts --bundle --format=esm --target=es2022 --sourcemap=inline --watch --outfile=../custom_components/homelab_wrapped/frontend/homelab-wrapped-panel.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "lit": "3.2.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
